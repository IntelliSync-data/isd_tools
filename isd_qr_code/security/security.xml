<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_isd_qr_code" model="ir.module.category">
        <field name="name">QR Code Studio</field>
        <field name="sequence">40</field>
    </record>
    <record id="group_qr_user" model="res.groups">
        <field name="name">Người dùng (mã của mình)</field>
        <field name="category_id" ref="module_category_isd_qr_code"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_qr_manager" model="res.groups">
        <field name="name">Quản lý (mọi mã)</field>
        <field name="category_id" ref="module_category_isd_qr_code"/>
        <field name="implied_ids" eval="[(4, ref('group_qr_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <!-- Mọi nhân viên dùng được QR Studio -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_qr_user'))]"/>
    </record>

    <!-- Mã QR có thể chứa mật khẩu Wi-Fi: mỗi người chỉ thấy mã của mình -->
    <record id="rule_qr_code_own" model="ir.rule">
        <field name="name">Mã QR: chỉ mã của mình</field>
        <field name="model_id" ref="model_isd_qr_code"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_qr_user'))]"/>
    </record>
    <record id="rule_qr_code_all" model="ir.rule">
        <field name="name">Mã QR: quản lý thấy tất cả</field>
        <field name="model_id" ref="model_isd_qr_code"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_qr_manager'))]"/>
    </record>
    <record id="rule_qr_code_company" model="ir.rule">
        <field name="name">Mã QR: theo công ty</field>
        <field name="model_id" ref="model_isd_qr_code"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
