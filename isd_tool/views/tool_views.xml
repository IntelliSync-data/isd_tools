<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hub" model="ir.actions.client">
        <field name="name">ISD Tools</field>
        <field name="tag">isd_tool.hub</field>
        <field name="path">isd-tools</field>
    </record>

    <record id="view_tool_list" model="ir.ui.view">
        <field name="name">isd.tool.list</field>
        <field name="model">isd.tool</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="icon" widget="image" options="{'size': [32, 32]}"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="group_ids" widget="many2many_tags" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tool_form" model="ir.ui.view">
        <field name="name">isd.tool.form</field>
        <field name="model">isd.tool</field>
        <field name="arch" type="xml">
            <form string="Tool">
                <sheet>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-danger" invisible="active"/>
                    <field name="icon" widget="image" class="oe_avatar" options="{'size': [96, 96]}"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="description" placeholder="One line about what the tool does"/>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="action_id"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="link_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="action_id"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tool_search" model="ir.ui.view">
        <field name="name">isd.tool.search</field>
        <field name="model">isd.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter string="Hidden" name="hidden" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tool" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="res_model">isd.tool</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tool installed yet</p>
            <p>Install an ISD tool from Apps and its card appears here.</p>
        </field>
    </record>

    <record id="view_tool_category_list" model="ir.ui.view">
        <field name="name">isd.tool.category.list</field>
        <field name="model">isd.tool.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_tool_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">isd.tool.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
